DATABASE_URL="file:./dev.db"

# Clave global de IA (opcional). Cada usuario puede configurar su propia
# clave, endpoint y modelo en /configuracion; se guardan solo en su navegador.
# Proveedor de IA (opcional; endpoint compatible con chat completions)
AI_API_KEY="tu-clave-aqui"
# Opcionales:
# AI_MODEL="tu-modelo"
# AI_BASE_URL="https://tu-proveedor.example/v1"
# AI_ENABLE_THINKING="true"

# Autenticación de acceso (obligatoria para proteger la app)
APP_PASSWORD="cambia-esta-contrasena"
APP_SESSION_SECRET="genera-un-secreto-largo-y-aleatorio"
# Opcional: limitar endpoints de IA a hosts concretos
# AI_ALLOWED_HOSTS="api.ejemplo.com,otro.ejemplo.com"
